[Unit]
Description=Carnation record keepsake numbering and visitor counts
After=network.target

[Service]
ExecStart=/usr/bin/python3 -B /opt/flower-cafe/record-number/record_numbers.py --database /var/lib/flower-record-number/records.sqlite3
Restart=on-failure
DynamicUser=yes
StateDirectory=flower-record-number
StateDirectoryMode=0700
LoadCredential=visitor-stats-key:/etc/flower-cafe/visitor-stats-key
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
